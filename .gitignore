# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app
*.symbols.zip

# Android build output (IL2CPP symbols and Burst debug info next to the apk)
BystanderTest_BackUpThisFolder_ButDontShipItWithYourGame/
Bystander_BurstDebugInformation_DoNotShip/
*_BackUpThisFolder_ButDontShipItWithYourGame/
*_BurstDebugInformation_DoNotShip/

# Stray compiled assembly in the project root
TempAssembly.dll

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Android/Quest signing keys, never commit
*.keystore
*.jks

# Meta SDK local/machine-specific files, never commit
# (DevAgentSettings holds a personal access token and local network address)
/Assets/Resources/DevAgentSettings.asset
/Assets/Resources/DevAgentSettings.asset.meta
# XR Operator layer binary, copied here by Activate and rebuilt on demand
/Assets/XR/APILayers~/

# Meta SDK per-machine IDs (project guid and a session id that changes every run)
/Assets/#Meta/
/Assets/#Meta.meta

# Profiler and performance traces (Perfetto captures from the Quest get large)
*.perfetto-trace
*.pftrace

# Generated by the Animation Check editor tool (Bystander > Animation Check); rebuilt on demand
/AnimationChecks/

# Claude Code per-machine files (the shared XR Operator skills in .claude stay tracked)
/.claude/settings.local.json
/.claude/worktrees/

# Editor, OS and merge leftovers
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini
*.orig
*.rej

# Documents kept out of the repo: the thesis export and the printable mocap and technician sheets
Bystander_Thesis.docx
Mocap_List.html
Mocap_List.pdf
Technician_Notes.html
Technician_Notes.pdf

# Office lock files (Word makes these while a doc is open)
~$*

# Not needed to build the APK (kept on disk, not published)
/SoundReview/
/Branding/
/ParkedStreet/
/.claude/
/HANDOFF.md
/scratch_reqs.json
/reqs_only.json
/.vsconfig
# Original sound/dialogue files; the build uses the processed copies in Assets/Resources/Audio
/Assets/Audio/
/Assets/Audio.meta
